{
  "manifest_version": 3,
  "name": "Sieve",
  "version": "0.1.0",
  "description": "Invisible cross-feed caliber filter and UI debloat for YouTube, Twitter, and Instagram.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://dearrow.minibomba.pro/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Sieve",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "styles/youtube.css",
        "styles/dim.css"
      ],
      "js": [
        "dist/content-youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "css": [
        "styles/twitter.css",
        "styles/dim.css"
      ],
      "js": [
        "dist/content-twitter.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "dist/intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "css": [
        "styles/instagram.css",
        "styles/dim.css"
      ],
      "js": [
        "dist/content-instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "dist/intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
